# Copy this file to .env and fill in the values. `just run` reads .env.
# Never commit .env: it holds secrets.

# The address that people use to open Runwall. It must agree with the
# callback URL of the GitHub App (BASE_URL + /auth/callback).
BASE_URL=http://127.0.0.1:8080

# From the settings page of your GitHub App.
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_FILE=./runwall.private-key.pem
GITHUB_WEBHOOK_SECRET=replace-with-the-webhook-secret
GITHUB_CLIENT_ID=replace-with-the-client-id
GITHUB_CLIENT_SECRET=replace-with-the-client-secret

# Encrypts sessions and stored tokens. Make it with: openssl rand -hex 32
SESSION_KEY=replace-with-64-hex-characters

# Optional. See the configuration table in README.md.
# ALLOWED_ACCOUNTS=my-org,my-user
# ALLOWED_USERS=
# ADMIN_USERS=
