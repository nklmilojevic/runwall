# 1Password secret references (not secrets). Used by `make run` via `op run --env-file=secrets.op`.
# Point these at wherever you store the GitHub App's credentials.
GITHUB_APP_ID=op://Private/GitHub Actions Dashboard App/app_id
GITHUB_APP_PRIVATE_KEY=op://Private/GitHub Actions Dashboard App/private_key
GITHUB_WEBHOOK_SECRET=op://Private/GitHub Actions Dashboard App/webhook_secret
GITHUB_CLIENT_ID=op://Private/GitHub Actions Dashboard App/client_id
GITHUB_CLIENT_SECRET=op://Private/GitHub Actions Dashboard App/client_secret
SESSION_KEY=op://Private/GitHub Actions Dashboard App/session_key
