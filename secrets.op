# 1Password secret references (not secrets). Used by `just run` via `op run --env-file=secrets.op`.
# Point these at wherever you store the GitHub App's credentials.
GITHUB_APP_ID=op://homecluster/runwall/app_id
GITHUB_APP_PRIVATE_KEY=op://homecluster/runwall/private_key
GITHUB_WEBHOOK_SECRET=op://homecluster/runwall/webhook_secret
GITHUB_CLIENT_ID=op://homecluster/runwall/client_id
GITHUB_CLIENT_SECRET=op://homecluster/runwall/client_secret
SESSION_KEY=op://homecluster/runwall/session_key
